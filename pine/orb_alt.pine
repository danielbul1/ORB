//@version=6
// ORB Alt Track: the ADR 0008 breakout chassis and its pre-registered Hypotheses H1-H5, with the trading UI
// (Opening Range box with midpoint, two-stage alerts, stop/target boxes, a "why no trade" table, Lucid Flex tracker).
// Mirrors research/alt_track.py (orb/backtest.py run(**CHASSIS, ...)). The trades this script simulates follow the
// engine's fill rules: entry at the next open after a 5m close beyond the OR (H1: limit at the broken edge), stop
// checked before target in the same bar, no target on the entry bar, stops gapped through fill at the open, flat at
// 15:59. Rule values are limited to the registered grids. Use a 1-minute NQ/MNQ chart; H3 needs extended hours.
// pine/orb_alt_indicator.pine is generated from this file by tools/pine_twin.py: edit this file only.
// <strategy>
strategy("ORB Alt Track", overlay = true, initial_capital = 150000, commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.62, slippage = 1, default_qty_type = strategy.fixed, default_qty_value = 1,
     margin_long = 0, margin_short = 0, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)
// </strategy>
// <indicator> indicator("ORB Alt Track (indicator)", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

G1 = "Rule Set (ADR 0008)"
preset  = input.string("Chassis", "Rule Set", options = ["Chassis", "H1 retest", "H2 midpoint stop", "H3 pre-open range", "H4 IB + volume", "H5 narrow OR"], group = G1)
h1Win   = input.int(30, "H1: retest window (min)", options = [15, 30, 60], group = G1)
h2Frac  = input.float(0.5, "H2: stop at x OR width past the broken edge", options = [0.5, 0.75, 0.4], group = G1)
h3Win   = input.string("09:15-09:44", "H3: range", options = ["09:15-09:29", "09:15-09:44", "09:29-09:40"], group = G1)
h4Vol   = input.float(1.5, "H4: breakout volume x 20-Session mean", options = [1.0, 1.5, 2.0], group = G1)
h5Max   = input.float(0.25, "H5: max OR width x ATR14", options = [0.15, 0.25, 0.35], group = G1)
G2 = "Size"
riskUsd = input.float(500, "Risk per trade (USD), at least 1 contract", step = 50, group = G2)
rtUsd   = input.float(1.74, "Round-trip cost per contract (USD), for the tracker", step = 0.1, group = G2)
G3 = "Lucid Flex tracker"
trackOn = input.bool(true, "Track an account", group = G3)
fromT   = input.time(timestamp("2026-10-01T00:00:00-04:00"), "Account start", group = G3)
acct    = input.float(150000, "Start balance", group = G3)
mllUsd  = input.float(4500, "Max loss (end-of-day trailing)", group = G3)
lockUsd = input.float(100, "Max loss locks at start + ", group = G3)
tgtUsd  = input.float(9000, "Profit target", group = G3)
blockMll = input.bool(true, "Skip a trade whose risk exceeds the room to max loss", group = G3)
G4 = "Display"
showTbl = input.bool(true, "Table", group = G4)
showBox = input.bool(true, "OR and risk boxes", group = G4)

// ---------------------------------------------------------------- effective rules
isH1 = preset == "H1 retest"
isH2 = preset == "H2 midpoint stop"
isH3 = preset == "H3 pre-open range"
isH4 = preset == "H4 IB + volume"
isH5 = preset == "H5 narrow OR"
TF = 5               // breakout = close of a 5-minute candle aligned to 09:30
TARGET_R = 2.0
orStart = isH3 ? (h3Win == "09:29-09:40" ? -1 : -15) : 0          // minutes from 09:30
orLen   = isH3 ? (h3Win == "09:15-09:29" ? 15 : h3Win == "09:15-09:44" ? 30 : 12) : isH4 ? 60 : 15
orEnd   = orStart + orLen                                           // first minute after the OR
entryFrom = math.max(orEnd, 0)
cutoffM = isH4 ? 269 : 149   // last breakout bar; the entry fills at the next open (12:00, H4 14:00)
EXIT_M  = 389                // flat at the 15:59 close
stopFrac = isH2 ? h2Frac : 1.0
maxOrAtr = isH5 ? h5Max : 9.0
bvolMin  = isH4 ? h4Vol : 0.0
retestW  = isH1 ? h1Win : 0
ruleName = preset + (isH1 ? " " + str.tostring(h1Win) + "m" : isH2 ? " " + str.tostring(h2Frac) : isH3 ? " " + h3Win :
     isH4 ? " " + str.tostring(h4Vol) + "x" : isH5 ? " " + str.tostring(h5Max) : "")

// ---------------------------------------------------------------- clock
TZ = "America/New_York"
m = hour(time, TZ) * 60 + minute(time, TZ) - 570      // minutes from 09:30 (negative before the open)
oneMin = timeframe.isminutes and timeframe.multiplier == 1
inWin = m >= -15 and m < 390
newDay = inWin and (not inWin[1] or dayofmonth(time, TZ) != dayofmonth(time[1], TZ))
isRth = m >= 0 and m < 390
lastBar = isRth and (m >= EXIT_M or session.islastbar_regular)
cv = math.sum(volume, TF)                                 // volume of the 5m candle ending on this bar

hhmm(int mm) =>
    t = 570 + mm
    str.tostring(math.floor(t / 60)) + ":" + (t % 60 < 10 ? "0" : "") + str.tostring(t % 60)

// ---------------------------------------------------------------- state
var float dH = na
var float dL = na
var float atr14 = na
var trs = array.new_float()
var float prevClose = na
var float lastRthClose = na
var float orH = na
var float orL = na
var bool preSeen = false
var int orBar = na
var vols = matrix.new<float>(21, 390, 0.0)   // 5m candle volume by bar: today's row + the prior 20 Sessions
var int vrow = 0
var int vdays = 0
var int dir = 0          // simulated position: 1 long, -1 short, 0 flat
var float ent = na
var float stp = na
var float tgt = na
var float risk = na
var int entM = na
var int qty = 0
var int pend = 0         // market entry waiting for the next open
var int lim = 0          // retest limit order waiting (H1)
var float limPx = na
var int limTo = na
var float pStop = na     // stop of the pending order (known from the OR)
var bool done = false    // today's setup is consumed
var bool readyL = false
var bool readyS = false
var string status = "Waiting for the Session"
var float dayPnl = 0.0
var int dayTrades = 0
var float bal = na
var float peakEod = na
var float bestDay = 0.0
var box orBox = na
var line midLn = na
var box sBox = na
var box tBox = na

// ---------------------------------------------------------------- new Session
if newDay
    if not na(dH)
        tr = na(prevClose) ? dH - dL : math.max(dH - dL, math.abs(dH - prevClose), math.abs(dL - prevClose))
        trs.push(tr)
        if trs.size() > 14
            trs.shift()
        atr14 := trs.size() == 14 ? trs.avg() : na
        prevClose := lastRthClose
    if not na(bal)
        peakEod := math.max(peakEod, bal)
        bestDay := math.max(bestDay, dayPnl)
    dH := na
    dL := na
    orH := na
    orL := na
    preSeen := false
    orBar := na
    vrow := (vrow + 1) % 21
    vdays += 1
    for j = 0 to 389
        vols.set(vrow, j, 0.0)
    pend := 0
    lim := 0
    done := false
    readyL := false
    readyS := false
    dayPnl := 0.0
    dayTrades := 0
    status := "Waiting for the OR (" + hhmm(orStart) + "-" + hhmm(orEnd - 1) + ")"

if trackOn and time >= fromT and na(bal)
    bal := acct
    peakEod := acct
mllFloor = na(peakEod) ? na : math.min(peakEod - mllUsd, acct + lockUsd)

if isRth
    dH := na(dH) ? high : math.max(dH, high)
    dL := na(dL) ? low : math.min(dL, low)
    lastRthClose := close
    vols.set(vrow, m, cv)

// ---------------------------------------------------------------- Opening Range
if inWin and m >= orStart and m < orEnd
    orH := na(orH) ? high : math.max(orH, high)
    orL := na(orL) ? low : math.min(orL, low)
    orBar := na(orBar) ? bar_index : orBar
    if m < 0
        preSeen := true
orReady = not na(orH) and m >= orEnd - 1 and inWin
width = orH - orL
orAtr = width / atr14
if showBox and inWin and m == orEnd - 1 and not na(orH)
    orBox := box.new(orBar, orH, bar_index, orL, border_color = color.new(color.gray, 30), bgcolor = color.new(color.gray, 88))
    midLn := line.new(orBar, (orH + orL) / 2, bar_index, (orH + orL) / 2, color = color.gray, style = line.style_dotted)
if showBox and not na(orBox) and isRth and m <= EXIT_M and m >= orEnd
    orBox.set_right(bar_index)
    midLn.set_x2(bar_index)

stopFor(int d) =>
    d > 0 ? orH - stopFrac * (orH - orL) - syminfo.mintick : orL + stopFrac * (orH - orL) + syminfo.mintick
sizeFor(float rpts) =>
    math.max(1, math.floor(riskUsd / (rpts * syminfo.pointvalue)))
jsonMsg(string action, int q, string kind, float px, float sl, float tp) =>
    '{"ticker":"' + syminfo.ticker + '","action":"' + action + '","qty":' + str.tostring(q) + ',"type":"' + kind +
         '","price":' + str.tostring(px, format.mintick) + ',"stop":' + str.tostring(sl, format.mintick) +
         ',"target":' + str.tostring(tp, format.mintick) + ',"rule":"ORB Alt Track: ' + ruleName + '"}'

// ---------------------------------------------------------------- simulated fills (engine rules)
bool filled = false
if isRth and pend != 0
    dir := pend
    pend := 0
    ent := open
    filled := true
if isRth and lim != 0
    if m > limTo or m > cutoffM
        lim := 0
        status := "No trade: no retest within " + str.tostring(retestW) + " min"
        // <strategy>
        strategy.cancel("L")
        strategy.cancel("S")
        // </strategy>
    else if (lim > 0 and low <= limPx) or (lim < 0 and high >= limPx)
        dir := lim
        lim := 0
        ent := dir > 0 ? math.min(limPx, open) : math.max(limPx, open)
        filled := true
if filled
    stp := pStop
    risk := (ent - stp) * dir
    entM := m
    if risk <= 0
        status := "No trade: the fill is beyond the stop"
        dir := 0
        // <strategy>
        strategy.close_all("void", immediately = true)
        // </strategy>
    else
        tgt := ent + dir * TARGET_R * risk
        dayTrades += 1
        status := "In trade: " + (dir > 0 ? "long " : "short ") + str.tostring(qty) + " @ " + str.tostring(ent, format.mintick) +
             ", stop " + str.tostring(stp, format.mintick) + ", target " + str.tostring(tgt, format.mintick)
        if showBox
            sBox := box.new(bar_index, ent, bar_index, stp, border_color = na, bgcolor = color.new(color.red, 82))
            tBox := box.new(bar_index, tgt, bar_index, ent, border_color = na, bgcolor = color.new(color.green, 82))
        // <strategy>
        strategy.exit("X", stop = stp, limit = tgt)   // from the next bar: no target on the entry bar
        // </strategy>

// ---------------------------------------------------------------- simulated exits
if isRth and dir != 0
    bool out = false
    float xPx = na
    string why = ""
    if (dir > 0 and low <= stp) or (dir < 0 and high >= stp)
        out := true
        xPx := dir > 0 ? math.min(stp, open) : math.max(stp, open)
        why := "stop"
    else if m > entM and ((dir > 0 and high >= tgt) or (dir < 0 and low <= tgt))
        out := true
        xPx := tgt
        why := "target"
    else if lastBar
        out := true
        xPx := close
        why := "time"
    if showBox and not na(sBox)
        sBox.set_right(bar_index)
        tBox.set_right(bar_index)
    if out
        r = dir * (xPx - ent) / risk
        usd = dir * (xPx - ent) * qty * syminfo.pointvalue - rtUsd * qty
        dayPnl += usd
        if not na(bal)
            bal += usd
        status := "Done: " + why + " " + (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R (" + (usd >= 0 ? "+$" : "-$") +
             str.tostring(math.abs(usd), "#,###") + ")"
        label.new(bar_index, xPx, (r >= 0 ? "+" : "") + str.tostring(r, "#.#") + "R", style = label.style_label_left,
             color = color.new(r >= 0 ? color.green : color.red, 20), textcolor = color.white, size = size.small)
        alert('{"ticker":"' + syminfo.ticker + '","action":"exit","reason":"' + why + '","rule":"ORB Alt Track: ' + ruleName + '"}',
             alert.freq_once_per_bar_close)
        dir := 0
// <strategy>
if strategy.position_size != 0 and lastBar
    strategy.close_all("EOD", immediately = true)
// </strategy>

// ---------------------------------------------------------------- setup: why (no) trade
canLook = isRth and orReady and not done and dir == 0 and pend == 0 and lim == 0
if canLook
    if not oneMin
        status := "Use a 1-minute chart"
        done := true
    else if orStart < 0 and not preSeen
        status := "No trade: " + preset + " needs extended hours on the chart"
        done := true
    else if na(atr14)
        status := "No trade: ATR14 needs 14 Sessions of history"
        done := true
    else if orAtr > maxOrAtr
        status := "No trade: OR " + str.tostring(orAtr, "#.##") + " ATR > " + str.tostring(maxOrAtr) + " (H5)"
        done := true
    else if m > cutoffM
        status := "No trade: no 5m close beyond the OR by " + hhmm(cutoffM + 1)
        done := true
    else if m >= entryFrom
        status := "Waiting for a 5m close beyond the OR (until " + hhmm(cutoffM + 1) + ")"
        // Stage 1 alert: price is through a level, the 5m close decides.
        if high > orH and not readyL
            readyL := true
            alert("Get ready LONG " + syminfo.ticker + ": above OR high " + str.tostring(orH, format.mintick) + ", 5m close decides",
                 alert.freq_once_per_bar)
        if low < orL and not readyS
            readyS := true
            alert("Get ready SHORT " + syminfo.ticker + ": below OR low " + str.tostring(orL, format.mintick) + ", 5m close decides",
                 alert.freq_once_per_bar)
        brk = (m + 1) % TF == 0
        d = brk ? (close > orH ? 1 : close < orL ? -1 : 0) : 0
        if d != 0
            done := true    // the first break is the Session's only setup
            bool volOk = true
            float vr = na
            if bvolMin > 0
                float tot = 0.0
                for r = 0 to 20
                    tot += vols.get(r, m)
                mean = vdays > 20 ? (tot - vols.get(vrow, m)) / 20 : na
                vr := cv / mean
                volOk := not na(mean) and cv >= bvolMin * mean
            if not volOk
                status := "No trade: breakout volume " + (na(vr) ? "n/a (needs 20 Sessions)" : str.tostring(vr, "#.##") + "x") +
                     " < " + str.tostring(bvolMin) + "x (H4)"
            else
                pStop := stopFor(d)
                px = retestW > 0 ? (d > 0 ? orH : orL) : close
                rpts = (px - pStop) * d
                qty := sizeFor(rpts)
                riskD = rpts * qty * syminfo.pointvalue
                room = na(bal) ? na : bal - mllFloor
                if blockMll and not na(room) and riskD > room
                    status := "No trade: risk $" + str.tostring(riskD, "#,###") + " > room to max loss $" + str.tostring(room, "#,###")
                else
                    side = d > 0 ? "buy" : "sell"
                    tp = px + d * TARGET_R * rpts
                    if retestW > 0
                        lim := d
                        limPx := px
                        limTo := m + retestW
                        status := "Retest: limit " + side + " " + str.tostring(qty) + " @ " + str.tostring(px, format.mintick) +
                             " until " + hhmm(math.min(limTo, cutoffM))
                        alert(jsonMsg(side, qty, "limit", px, pStop, tp), alert.freq_once_per_bar_close)
                        // <strategy>
                        strategy.entry(d > 0 ? "L" : "S", d > 0 ? strategy.long : strategy.short, qty = qty, limit = px)
                        strategy.exit("X", stop = pStop)
                        // </strategy>
                    else
                        pend := d
                        status := "Entry: " + side + " " + str.tostring(qty) + " at the next open"
                        alert(jsonMsg(side, qty, "market", px, pStop, tp), alert.freq_once_per_bar_close)
                        // <strategy>
                        strategy.entry(d > 0 ? "L" : "S", d > 0 ? strategy.long : strategy.short, qty = qty)
                        strategy.exit("X", stop = pStop)
                        // </strategy>

// ---------------------------------------------------------------- table
var tbl = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 15), border_width = 1)
cell(int row, string k, string v, color c) =>
    tbl.cell(0, row, k, text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    tbl.cell(1, row, v, text_color = c, text_size = size.small, text_halign = text.align_left)
if showTbl and barstate.islast
    sc = str.startswith(status, "No trade") or str.startswith(status, "Use") ? color.orange :
         str.startswith(status, "In trade") or str.startswith(status, "Entry") or str.startswith(status, "Retest") ? color.aqua : color.white
    filt = isH1 ? "Retest of the broken edge within " + str.tostring(h1Win) + " min" :
         isH4 ? "Breakout 5m volume >= " + str.tostring(h4Vol) + "x its 20-Session mean" :
         isH5 ? "OR width <= " + str.tostring(h5Max) + " ATR14 (now " + (na(orAtr) ? "-" : str.tostring(orAtr, "#.##")) + ")" :
         isH2 ? "Stop " + str.tostring(h2Frac) + " of the OR past the broken edge" :
         isH3 ? "Range " + h3Win + " (needs extended hours)" : "None: plain breakout, stop at the other side, 2R"
    cell(0, "Rule Set", ruleName, color.white)
    cell(1, "OR", na(orH) ? "-" : "H " + str.tostring(orH, format.mintick) + " / Mid " + str.tostring((orH + orL) / 2, format.mintick) +
         " / L " + str.tostring(orL, format.mintick) + (na(orAtr) ? "" : " (" + str.tostring(orAtr, "#.##") + " ATR)"), color.white)
    cell(2, "Rule", filt, color.white)
    cell(3, "Status", status, sc)
    cell(4, "Today", str.tostring(dayTrades) + " trade(s), " + (dayPnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(dayPnl), "#,###"),
         dayPnl >= 0 ? color.white : color.orange)
    if not na(bal)
        prof = bal - acct
        cell(5, "Account", "$" + str.tostring(bal, "#,###") + " (" + (prof >= 0 ? "+" : "") + str.tostring(prof, "#,###") + " of " +
             str.tostring(tgtUsd, "#,###") + ")", color.white)
        room = bal - mllFloor
        cell(6, "Room to max loss", "$" + str.tostring(room, "#,###") + " (floor " + str.tostring(mllFloor, "#,###") + ")",
             room < 2 * riskUsd ? color.orange : color.white)
        best = math.max(bestDay, dayPnl)
        cell(7, "Consistency", prof > 0 ? "best day " + str.tostring(100 * best / prof, "#") + "% of profit (needs <= 50%)" : "-",
             prof > 0 and best > 0.5 * prof ? color.orange : color.white)

plot(orReady ? orH : na, "OR high", color.new(color.teal, 0), style = plot.style_linebr)
plot(orReady ? orL : na, "OR low", color.new(color.red, 0), style = plot.style_linebr)
plot(atr14, "ATR14 RTH", display = display.data_window)
